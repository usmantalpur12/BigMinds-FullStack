{
  "expo": {
    "name": "BigMinds Education",
    "slug": "bigminds-education",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1D4ED8"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bigminds.education"
    },
    "android": {
      "package": "com.bigminds.education",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#4C6EF5"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "scheme": "bigminds",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "31f030b0-9d8b-41ed-bf1e-242af4a8a250"
      }
    },
    "owner": "usmantalpur12"
  }
}
